{
  "name": "centari-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "worker:arxiv": "tsx worker/src/arxiv.ts",
    "worker:arxiv:dry": "tsx worker/src/arxiv.ts --dry-run --per-category=3",
    "worker:arxiv:compare": "tsx worker/src/arxiv.ts --dry-run --per-category=8",
    "worker:arxiv:once": "tsx worker/src/arxiv.ts --per-category=5 --days=7",
    "worker:cordis": "tsx worker/src/cordis.ts",
    "worker:cordis:dry": "tsx worker/src/cordis.ts --dry-run --max=10",
    "worker:nasa": "tsx worker/src/nasa.ts",
    "worker:nasa:dry": "tsx worker/src/nasa.ts --dry-run --max=10",
    "worker:nsf": "tsx worker/src/nsf.ts",
    "worker:nsf:dry": "tsx worker/src/nsf.ts --dry-run --max=10",
    "worker:osti": "tsx worker/src/osti.ts",
    "worker:osti:dry": "tsx worker/src/osti.ts --dry-run --max=10",
    "worker:openalex": "tsx worker/src/openalex.ts",
    "worker:openalex:dry": "tsx worker/src/openalex.ts --dry-run --max=10",
    "worker:snapshot:daily": "tsx worker/src/snapshots.ts --period=daily",
    "worker:snapshot:weekly": "tsx worker/src/snapshots.ts --period=weekly",
    "worker:snapshot:monthly": "tsx worker/src/snapshots.ts --period=monthly",
    "worker:snapshot:dry": "tsx worker/src/snapshots.ts --period=daily --dry-run",
    "worker:journal": "tsx worker/src/journal-curator.ts --period=daily",
    "worker:journal:dry": "tsx worker/src/journal-curator.ts --period=daily --dry-run",
    "worker:daily": "bash scripts/research-daily.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.108.1",
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^12.10.0",
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "^5.9.3",
    "maplibre-gl": "^5.24.0",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
