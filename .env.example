# Centari environment template
# Copy to .env and fill in values. Never commit .env to git.

# ── Supabase (remote) ─────────────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── MapLibre / MapTiler (public — read-only tile key) ────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY

# ── PostgreSQL (local service) ────────────────────────────────────────────────
# Choose a strong random password — this database is not exposed to the internet
POSTGRES_USER=centari
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=centari

# ── Ollama ────────────────────────────────────────────────────────────────────
# Internal Docker network address — do not change unless overriding
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# ── Research worker ───────────────────────────────────────────────────────────
# Cron schedule (default: every 6 hours)
WORKER_CRON=0 */6 * * *
LOG_LEVEL=info
